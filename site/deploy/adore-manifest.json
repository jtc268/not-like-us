{
  "build": {
    "context": ".",
    "dockerfile": "site/Containerfile",
    "test_argv": [
      "docker",
      "build",
      "--platform",
      "linux/amd64",
      "--target",
      "test",
      "-f",
      "site/Containerfile",
      "."
    ]
  },
  "health": {
    "path": "/healthz"
  },
  "hostname": "notlikeus.adorellc.pro",
  "runtime": {
    "cpu_shares": 256,
    "memory_limit": "512m",
    "port": 8080,
    "startup_timeout_seconds": 120,
    "tmpfs_limit": "64m"
  },
  "schema_version": 1,
  "secrets": {
    "required": [
      "STRIPE_SECRET_KEY",
      "STRIPE_PRICE_ID",
      "STRIPE_PORTAL_CONFIG_ID",
      "NLU_KEY_SECRET",
      "RESEND_API_KEY",
      "NLU_FROM_EMAIL",
      "NLU_SOURCE_REPO",
      "NLU_SOURCE_TOKEN",
      "STRIPE_PASS_PRICE_ID",
      "NLU_X402_PAY_TO"
    ]
  },
  "slug": "notlikeus",
  "source_repo": "https://github.com/jtc268/not-like-us.git",
  "state": "stateless"
}
